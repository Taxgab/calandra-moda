---
import { navigation } from '../data/site';
import WhatsAppCta from './WhatsAppCta.astro';
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-ivory/85 backdrop-blur-md">
  <div class="shell flex h-[4.5rem] items-center justify-between gap-6 md:h-20">
    <a
      href="/#inicio"
      class="flex flex-col leading-none text-ink"
      aria-label="Calandra Moda — ir al inicio"
    >
      <span class="font-display text-[1.7rem] leading-none tracking-[0.01em]">Calandra</span>
      <span class="mt-[0.32rem] pl-[0.12em] text-[0.5rem] uppercase tracking-[0.46em] text-gold">Moda</span>
    </a>

    <nav class="hidden lg:block" aria-label="Navegación principal">
      <ul class="flex items-center gap-8 xl:gap-10">
        {navigation.map((item) => (
          <li>
            <a href={item.href} class="nav-link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <WhatsAppCta
        context="header"
        label="Consultar por WhatsApp"
        class="hidden !px-5 !py-3.5 !text-[0.62rem] md:inline-flex"
      />

      <details id="menu-movil" class="group relative lg:hidden">
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center border border-line text-ink transition-colors duration-300 hover:border-gold hover:text-gold [&::-webkit-details-marker]:hidden"
          aria-label="Abrir menú de navegación"
        >
          <span class="relative block h-[0.85rem] w-5" aria-hidden="true">
            <span class="absolute inset-x-0 top-0 h-px bg-current transition-transform duration-300 group-open:translate-y-[0.4rem] group-open:rotate-45"></span>
            <span class="absolute inset-x-0 top-[0.4rem] h-px bg-current transition-opacity duration-300 group-open:opacity-0"></span>
            <span class="absolute inset-x-0 top-[0.8rem] h-px bg-current transition-transform duration-300 group-open:-translate-y-[0.4rem] group-open:-rotate-45"></span>
          </span>
        </summary>

        <div
          class="absolute right-0 top-[calc(100%+0.9rem)] max-h-[calc(100dvh-6rem)] w-[min(20rem,calc(100vw-2.5rem))] overflow-y-auto border border-line bg-ivory p-6 shadow-[0_28px_60px_-30px_rgba(27,24,21,0.45)]"
        >
          <nav aria-label="Navegación principal en móvil">
            <ul class="flex flex-col">
              {navigation.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="flex items-center justify-between border-b border-line/70 py-4 text-[0.7rem] uppercase tracking-[0.2em] text-ink-soft transition-colors hover:text-gold"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <WhatsAppCta
            context="header"
            label="Consultar por WhatsApp"
            class="mt-6 w-full !px-4 !py-4 !text-[0.62rem]"
          />
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Progresivo: el menú funciona sin JavaScript; esto sólo lo cierra al navegar.
  const menu = document.getElementById('menu-movil');

  if (menu instanceof HTMLDetailsElement) {
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false;
      });
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (menu.open && target instanceof Node && !menu.contains(target)) {
        menu.open = false;
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.querySelector('summary')?.focus();
        menu.open = false;
      }
    });
  }
</script>
