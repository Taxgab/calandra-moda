---
import type { FaqItem } from '../data/faq';
import { absoluteUrl, site } from '../data/site';
import { buildStructuredData } from '../lib/structured-data';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  faqs?: FaqItem[];
}

const {
  title = site.seo.title,
  description = site.seo.description,
  image = site.seo.ogImage,
  imageAlt = site.seo.ogImageAlt,
  noindex = false,
  faqs = [],
} = Astro.props;

const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl(image);

// "<" escapado: evita cortar el bloque JSON-LD si un texto lo incluyera.
const jsonLd = JSON.stringify(buildStructuredData(faqs)).replace(/</g, '\\u003c');
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex
  ? <meta name="robots" content="noindex, nofollow" />
  : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

<meta name="theme-color" content="#faf6ef" />
<meta name="author" content={site.name} />
<meta name="geo.region" content="AR-B" />
<meta name="geo.placename" content={`${site.city}, ${site.region}`} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<script type="application/ld+json" set:html={jsonLd} />
