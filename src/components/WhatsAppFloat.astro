---
import { MessageCircle } from '@lucide/astro';
import { isWhatsAppConfigured, whatsappUrl } from '../data/site';

const linkProps = isWhatsAppConfigured ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a
  href={whatsappUrl('contacto')}
  {...linkProps}
  class="fixed bottom-[max(1.25rem,env(safe-area-inset-bottom))] right-4 z-40 flex h-[3.4rem] w-[3.4rem] items-center justify-center rounded-full bg-ink text-ivory ring-1 ring-ivory/25 shadow-[0_18px_40px_-14px_rgba(27,24,21,0.6)] transition-transform duration-300 hover:scale-[1.04] md:hidden print:hidden"
  aria-label="Consultar por WhatsApp"
  data-cta="whatsapp-float"
>
  <MessageCircle size={22} stroke-width={1.5} aria-hidden="true" />
</a>
