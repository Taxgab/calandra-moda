---
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import type { ImageMetadata } from 'astro';
import TestImageBadge from './TestImageBadge.astro';

interface Props {
  index: string;
  title: string;
  description: string;
  href: string;
  image: ImageMetadata;
  alt: string;
  /** Desplazamiento editorial opcional en escritorio. */
  offset?: string;
  /** Ancho aproximado de la tarjeta, para el srcset. */
  sizes?: string;
}

const { index, title, description, href, image, alt, offset = '', sizes = '(min-width: 768px) 30vw, 100vw' } =
  Astro.props;
---

<article class:list={['group relative flex flex-col', offset]}>
  <div class="media-zoom relative aspect-[3/4] w-full">
    <Image
      src={image}
      alt={alt}
      widths={[320, 480, 720, 960]}
      sizes={sizes}
      format="webp"
      quality={78}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
    <TestImageBadge />
  </div>

  <div class="mt-6 flex items-baseline gap-3 border-t border-ink/12 pt-5">
    <span class="font-display text-[0.82rem] leading-none text-gold">{index}</span>
    <h3 class="font-display text-[1.7rem] font-normal leading-none text-ink">
      {/* El enlace cubre toda la tarjeta con un overlay: un solo destino accesible. */}
      <a href={href} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-offset-4">
        {title}
      </a>
    </h3>
  </div>

  <p class="mt-3 max-w-[26rem] text-[0.9rem] leading-[1.8] text-muted">{description}</p>

  <span
    class="mt-5 inline-flex items-center gap-2 text-[0.66rem] uppercase tracking-[0.2em] text-ink transition-colors group-hover:text-gold"
  >
    Ver colección
    <ArrowRight
      size={14}
      stroke-width={1.5}
      aria-hidden="true"
      class="transition-transform duration-500 group-hover:translate-x-1"
    />
  </span>
</article>
