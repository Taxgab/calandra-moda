---
import { MapPin } from '@lucide/astro';
import { isInstagramConfigured, isWhatsAppConfigured, site } from '../data/site';
import IconInstagram from './IconInstagram.astro';
import WhatsAppCta from './WhatsAppCta.astro';

const { address, contact } = site;
const hasPendingData = !isWhatsAppConfigured || !isInstagramConfigured || site.hours.length === 0;
---

<section id="contacto" class="border-t border-line/70 bg-ivory">
  <div class="shell py-20 md:py-28 lg:py-32">
    <div class="grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:gap-20">
      <div>
        <p class="eyebrow">Visitanos</p>
        <h2
          class="mt-6 max-w-[26rem] font-display text-[clamp(2.05rem,4.2vw,3.4rem)] font-normal leading-[1.08] tracking-[-0.01em] text-ink"
        >
          En el corazón de Lanús Este
        </h2>
        <p class="mt-5 max-w-[30rem] text-[0.98rem] leading-[1.85] text-muted">
          Te esperamos en {address.venue}. Podés acercarte a conocer las colecciones o escribirnos
          antes de tu visita.
        </p>

        <div class="mt-10 border-t border-line pt-7">
          <p class="text-[0.58rem] uppercase tracking-[0.26em] text-gold">Dirección</p>
          <address class="mt-3 not-italic">
            <span class="block font-display text-[1.5rem] leading-snug text-ink">{address.venue}</span>
            <span class="mt-1 block text-[0.95rem] leading-[1.8] text-muted">
              {address.street}<br />
              {address.locality}, {address.region}
            </span>
          </address>
          <a
            href={address.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline mt-5 inline-flex text-ink"
          >
            Abrir en Google Maps
          </a>
        </div>
      </div>

      <div class="border border-line bg-cream/50 p-7 md:p-10">
        <h3 class="font-display text-[1.7rem] font-normal leading-snug text-ink">
          Empezá la conversación
        </h3>
        <p class="mt-3 max-w-[26rem] text-[0.9rem] leading-[1.8] text-muted">
          Contanos qué ocasión estás buscando y te orientamos para encontrar el vestido adecuado.
        </p>

        <WhatsAppCta context="contacto" label="Escribir por WhatsApp" class="mt-7 w-full" />
        {
          !isWhatsAppConfigured && (
            <p class="mt-3 text-[0.72rem] leading-relaxed text-muted">
              Número de WhatsApp pendiente de confirmación.
            </p>
          )
        }

        <div class="mt-8 grid gap-3 border-t border-line pt-8 sm:grid-cols-2">
          <a
            href={address.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between gap-3 border border-ink/15 px-4 py-3.5 text-[0.64rem] uppercase tracking-[0.16em] text-ink transition-colors duration-300 hover:border-gold hover:text-gold"
          >
            Cómo llegar
            <MapPin size={15} stroke-width={1.5} aria-hidden="true" />
          </a>

          {
            isInstagramConfigured ? (
              <a
                href={contact.instagramUrl}
                target="_blank"
                rel="noopener noreferrer me"
                class="flex items-center justify-between gap-3 border border-ink/15 px-4 py-3.5 text-[0.64rem] uppercase tracking-[0.16em] text-ink transition-colors duration-300 hover:border-gold hover:text-gold"
              >
                {contact.instagramHandle || 'Instagram'}
                <IconInstagram size={15} />
              </a>
            ) : (
              <span class="flex items-center justify-between gap-3 border border-dashed border-line px-4 py-3.5 text-[0.64rem] uppercase tracking-[0.16em] text-muted">
                Instagram
                <span class="text-[0.52rem] tracking-[0.18em] text-gold">pendiente</span>
              </span>
            )
          }
        </div>

        {
          hasPendingData && (
            <p class="mt-7 border-t border-line pt-5 text-[0.72rem] leading-[1.8] text-muted">
              Los horarios de atención y los datos de contacto que todavía no están confirmados se
              publican en cuanto el cliente los valide.
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>
