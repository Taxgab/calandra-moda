---
import WhatsAppCta from './WhatsAppCta.astro';
---

<section class="border-y border-line/70 bg-cream/60">
  <div class="shell flex flex-col gap-6 py-10 md:flex-row md:items-center md:justify-between md:gap-10 md:py-12">
    <p class="max-w-xl font-display text-[1.4rem] leading-snug text-ink md:text-[1.6rem]">
      ¿No sabés por dónde empezar? Contanos qué ocasión estás buscando y te orientamos.
    </p>
    <WhatsAppCta
      context="categorias"
      label="Consultar por WhatsApp"
      variant="outline"
      class="self-start md:self-auto"
    />
  </div>
</section>
