---
import WhatsAppCta from './WhatsAppCta.astro';
---

<section class="border-t border-ink/10 bg-ink text-ivory">
  <div class="shell py-20 text-center md:py-28">
    <p class="eyebrow text-gold-soft">Calandra Moda</p>
    <h2
      class="mx-auto mt-7 max-w-[46rem] font-display text-[clamp(2.2rem,5vw,4rem)] font-normal leading-[1.05] tracking-[-0.015em] text-ivory"
    >
      Tu vestido especial merece una experiencia a la altura.
    </h2>
    <p class="mx-auto mt-6 max-w-[34rem] text-[0.98rem] leading-[1.9] text-ivory/70">
      Contactanos y comenzá a encontrar el vestido para tu próximo gran momento.
    </p>

    <div class="mt-10 flex flex-col items-center gap-5">
      <WhatsAppCta context="cta" label="Quiero recibir asesoramiento" variant="light" />
      <p class="text-[0.58rem] uppercase tracking-[0.24em] text-ivory/60">
        Atención personalizada · Lanús Este, Buenos Aires
      </p>
    </div>
  </div>
</section>
