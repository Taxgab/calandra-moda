---
import { Image } from 'astro:assets';
import { galleryChapters } from '../data/gallery';
import TestImageBadge from './TestImageBadge.astro';
import WhatsAppCta from './WhatsAppCta.astro';

const intro = {
  eyebrow: 'Galería editorial',
  title: 'Vestidos, texturas y siluetas',
  lead: 'Una recorrida visual por las tres colecciones de la boutique. Cada pieza se elige en persona, con asesoramiento y sin apuro.',
};
---

<section id="galeria" class="border-t border-line/70 bg-cream">
  <div class="shell py-20 md:py-28 lg:py-32">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between md:gap-16">
      <div class="max-w-2xl">
        <p class="eyebrow">{intro.eyebrow}</p>
        <h2
          class="mt-6 font-display text-[clamp(2.05rem,4.2vw,3.4rem)] font-normal leading-[1.08] tracking-[-0.01em] text-ink"
        >
          {intro.title}
        </h2>
        <p class="mt-5 text-[0.98rem] leading-[1.85] text-muted">{intro.lead}</p>
      </div>
      <p
        class="max-w-[17rem] border-l border-ink/15 pl-5 text-[0.62rem] uppercase leading-[1.9] tracking-[0.16em] text-muted md:text-left"
      >
        Fotografías de prueba: no corresponden a productos de Calandra Moda.
      </p>
    </div>

    <div class="mt-16 space-y-20 md:mt-20 md:space-y-28">
      {
        galleryChapters.map((chapter) => (
          <div id={chapter.id}>
            <div class="flex flex-col gap-4 border-t border-ink/12 pt-6 md:flex-row md:items-baseline md:justify-between">
              <div class="flex items-baseline gap-4">
                <span class="font-display text-[0.85rem] leading-none text-gold">{chapter.index}</span>
                <h3 class="font-display text-[1.85rem] font-normal leading-none text-ink">{chapter.title}</h3>
              </div>
              <p class="max-w-md text-[0.86rem] leading-[1.8] text-muted md:text-right">{chapter.description}</p>
            </div>

            <div class="mt-8 grid grid-cols-1 items-start gap-5 sm:grid-cols-2 md:grid-cols-12 md:gap-5">
              {chapter.items.map((item) => (
                <figure class:list={['media-zoom relative m-0', item.span, item.ratio, item.offset]}>
                  <Image
                    src={item.src}
                    alt={item.alt}
                    widths={[400, 640, 960]}
                    sizes="(min-width: 1024px) 45vw, (min-width: 640px) 50vw, 100vw"
                    format="webp"
                    quality={78}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                  <TestImageBadge class="bottom-2 left-2" />
                </figure>
              ))}
            </div>

            <div class="mt-8">
              <WhatsAppCta
                context={chapter.whatsapp}
                label={`Consultar por ${chapter.title.toLowerCase()}`}
                variant="inline"
                icon={false}
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
